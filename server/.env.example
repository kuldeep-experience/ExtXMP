NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/experience_visitor_platform
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=480
BCRYPT_ROUNDS=12
API_RATE_LIMIT_MAX=1500
LOGIN_RATE_LIMIT_MAX=10
SENSITIVE_RATE_LIMIT_MAX=30
# dev = emails go to a development-only outbox (never in production); none = send nothing
EMAIL_MODE=dev
# Seed demo data when the server starts on an empty database (ignored in production). Set false to disable.
AUTO_SEED=true
# Optional. Defaults to http://localhost:PORT with `npm start`, http://localhost:5173 with `npm run dev`
# CLIENT_URL=http://localhost:5173   # in production: the exact frontend origin, e.g. https://ext-xmp.vercel.app (no trailing slash)

# AI assistant. Leave empty to use the built-in demo mode (no model is called).
# AI_PROVIDER=openrouter      # demo | openrouter | openai (any OpenAI-compatible API) | anthropic
# OpenRouter example (key from https://openrouter.ai/keys, model id from https://openrouter.ai/models):
#   AI_PROVIDER=openrouter
#   AI_API_KEY=sk-or-...
#   AI_MODEL=openai/gpt-4o-mini
# AI_API_KEY=
# AI_MODEL=                   # required for a real provider; choose a model your account can use
# AI_BASE_URL=                # optional, for OpenAI-compatible servers
AI_RATE_LIMIT_MAX=30

# Review insights (cached per professional)
REVIEW_INSIGHTS_MIN_NEW_REVIEWS=5
REVIEW_INSIGHTS_COOLDOWN_SECONDS=600

# History: repeat views within this window do not count as new views
RECENTLY_VIEWED_DEDUP_MINUTES=30
